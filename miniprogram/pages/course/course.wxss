.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 0 0 120rpx;
}

/* 状态提示 */
.state-box {
  text-align: center;
  padding: 120rpx 0;
}
.state-text { font-size: 28rpx; color: #999; }
.error-text { font-size: 28rpx; color: #cf1322; display: block; margin-bottom: 24rpx; }
.retry-btn {
  font-size: 28rpx; color: #2f54eb;
  padding: 10rpx 32rpx; border-radius: 10rpx; background: #e8f3ff;
}

/* 顶部课程卡片 */
.course-hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
  padding: 60rpx 40rpx 56rpx;
  color: #fff;
}
.course-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(102,126,234,0.5);
  color: #c5d0ff;
  margin-bottom: 20rpx;
}
.course-name {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 16rpx;
}
.course-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  margin-bottom: 28rpx;
}
.price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.course-price {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffd666;
}
.discount-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,214,102,0.2);
  color: #ffd666;
  border: 1rpx solid rgba(255,214,102,0.4);
}

/* 课程亮点 */
.section {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 24rpx;
}
.highlight-list { display: flex; flex-direction: column; gap: 18rpx; }
.highlight-item { display: flex; align-items: flex-start; gap: 12rpx; }
.highlight-dot { font-size: 28rpx; flex-shrink: 0; margin-top: 2rpx; }
.highlight-text { font-size: 28rpx; color: #444; line-height: 1.6; }

/* 行动按钮 */
.action-area {
  display: flex;
  gap: 20rpx;
  padding: 32rpx 24rpx 0;
}
.btn-trial, .btn-buy {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.btn-trial {
  background: #fff;
  color: #2f54eb;
  border: 2rpx solid #2f54eb;
  box-shadow: 0 4rpx 16rpx rgba(47,84,235,0.15);
}
.btn-trial::after { border: none; }
.btn-buy {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.45);
}
.btn-buy::after { border: none; }
.btn-icon-text { font-size: 32rpx; }

/* 底部提示 */
.bottom-tip {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 28rpx 0 0;
}
