.result-page {
  background: linear-gradient(180deg, #2a2a40 0%, #4a4a6a 200rpx, #f5f7fa 300rpx);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 导航 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #1a1a2e;
  color: #fff;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
}
.back-icon {
  font-size: 36rpx;
}
.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
}

/* 分数区域 */
.score-section {
  padding: 100rpx 0;
  text-align: center;
  background: linear-gradient(180deg, #2a2a40 0%, #4a4a6a 100%);
}
.score-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 30rpx;
}
.score-num {
  font-size: 140rpx;
  font-weight: bold;
  color: #fff;
}
.score-total {
  font-size: 56rpx;
  color: #ccc;
  margin-left: 10rpx;
}
.level-tag {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: rgba(102, 126, 234, 0.25);
  border-radius: 40rpx;
  font-size: 32rpx;
  color: #667eea;
  font-weight: 500;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 30rpx;
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.card-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #1a1a1a;
}
.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 得分项 */
.category-list {
  margin-top: 20rpx;
}
.category-item {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.category-name {
  width: 220rpx;
  font-size: 28rpx;
  color: #333;
}
.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #e8e8e8;
  border-radius: 7rpx;
  margin: 0 20rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 7rpx;
}
.category-score {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  color: #667eea;
}

/* 提升建议 */
.suggest-item {
  display: flex;
  margin-bottom: 24rpx;
}
.suggest-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}
.suggest-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 资料包卡片 */
.material-card {
  margin: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  color: #fff;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.25);
}
.material-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gift-icon {
  margin-right: 16rpx;
  font-size: 44rpx;
}
.material-desc {
  display: block;
  font-size: 25rpx;
  opacity: 0.95;
  margin-bottom: 30rpx;
  white-space: nowrap;
  line-height: 1.3;
}
.material-btn {
  width: 60%;
  height: 80rpx;
  background: #fff;
  color: #667eea;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.1);
  margin: 0 auto;
  display: block;
}

/* 社群按钮 */
.community-btns {
  display: flex;
  justify-content: space-between;
}
.community-btn {
  width: 31%;
  padding: 30rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
  text-align: center;
}
.btn-icon {
  display: block;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}
.btn-text {
  font-size: 24rpx;
  color: #666;
}
.btn-text.blue {
  color: #667eea;
}

/* 重新测评 */
.restart-test {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗样式（你要的排版） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  width: 85%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}
.modal-header {
  margin-bottom: 24rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.modal-body {
  margin-bottom: 30rpx;
}
.qr-img {
  width: 70%;
  height: 420rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
}
.modal-tip {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.modal-wechat {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.btn-modal {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}
.btn-light {
  background: #f0f4ff;
  color: #667eea;
}
.btn-primary {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.modal-close {
  font-size: 28rpx;
  color: #999;
}