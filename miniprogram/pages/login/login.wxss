.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
.hero {
  text-align: center;
  margin-bottom: 60rpx;
}
.hero-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}
.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}
.login-card {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
}
.feature-list {
  margin-bottom: 48rpx;
}
.feature-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.feature-item:last-child {
  border-bottom: none;
}
.feature-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}
.feature-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}
.btn-wx-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.5);
  margin-bottom: 24rpx;
}
.btn-wx-login::after {
  border: none;
}
.btn-icon {
  font-size: 36rpx;
}
.privacy-tip {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
}

/* ── 第二步：完善头像昵称 ── */
.profile-step {
  width: 100%;
}
.profile-card {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像选择按钮 */
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 0 40rpx;
  background: rgba(255,255,255,0.1);
  border: 2rpx dashed rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.avatar-placeholder-icon {
  font-size: 48rpx;
}
.avatar-placeholder-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 昵称输入框 */
.nickname-wrap {
  width: 100%;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
}
.nickname-input {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  text-align: center;
}
.nickname-input::placeholder {
  color: rgba(255,255,255,0.35);
}

/* 完成按钮 */
.btn-save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.5);
  margin-bottom: 28rpx;
}
.btn-save::after { border: none; }

/* 跳过 */
.skip-tip {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  text-decoration: underline;
}