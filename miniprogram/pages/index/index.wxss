.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #f5f7fa 35%);
  padding-bottom: 40rpx;
}
.header {
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
}
.header-title { font-size: 44rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; }
.header-sub { font-size: 26rpx; color: rgba(255,255,255,0.6); }

/* 统计行 */
.stat-row {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 24rpx;
}
.stat-item {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.12);
}
.stat-value { font-size: 40rpx; font-weight: 700; color: #fff; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 6rpx; }

/* 快捷入口 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  padding: 0 30rpx 20rpx;
}
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}
.action-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.action-icon { font-size: 56rpx; margin-bottom: 16rpx; }
.action-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 8rpx; }
.action-desc { font-size: 22rpx; color: #999; }

/* 管理员看板 */
.admin-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  margin: 0 30rpx 24rpx;
  padding: 36rpx;
  color: #fff;
}
.admin-title { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }
.admin-stats { display: flex; gap: 0; }
.admin-stat { flex: 1; text-align: center; }
.admin-stat-val { font-size: 44rpx; font-weight: 700; }
.admin-stat-lbl { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }
.admin-divider { width: 1rpx; background: rgba(255,255,255,0.3); margin: 0 10rpx; }

/* 未登录提示 */
.login-tip {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.login-tip-text { font-size: 28rpx; color: #666; margin-bottom: 30rpx; }
.btn-go-login {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  border: none;
}
.btn-go-login::after { border: none; }
