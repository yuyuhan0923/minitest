.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a1a2e 0%, #f5f7fa 35%);
  padding-bottom: 60rpx;
}

.hero {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
}
.hero-icon     { font-size: 100rpx; margin-bottom: 20rpx; }
.hero-title    { font-size: 44rpx; font-weight: 700; color: #fff; margin-bottom: 16rpx; }
.hero-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.65); }

/* 资料列表 */
.material-card {
  background: #fff; border-radius: 24rpx;
  margin: 0 30rpx 24rpx; padding: 36rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.material-title {
  font-size: 28rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 20rpx;
}
.material-item {
  display: flex; align-items: center;
  padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f5;
}
.material-item:last-child { border-bottom: none; }
.material-check { font-size: 28rpx; color: #10b981; margin-right: 16rpx; font-weight: 700; }
.material-name  { font-size: 28rpx; color: #333; }

/* 表单 */
.form-card {
  background: #fff; border-radius: 24rpx;
  margin: 0 30rpx 24rpx; padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.form-item   { margin-bottom: 28rpx; }
.form-label  { font-size: 28rpx; color: #333; font-weight: 500; margin-bottom: 14rpx; }
.form-input  {
  width: 100%; height: 88rpx; background: #f5f7fa;
  border-radius: 16rpx; padding: 0 24rpx; font-size: 30rpx; color: #333;
  box-sizing: border-box; border: 2rpx solid transparent;
}
.form-input:focus { border-color: #667eea; background: #fff; }
.form-tip    { font-size: 22rpx; color: #999; margin-bottom: 20rpx; }
.privacy-tip {
  display: flex; align-items: center; background: #f0f4ff;
  border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 32rpx;
}
.privacy-icon { font-size: 28rpx; margin-right: 12rpx; }
.privacy-text { font-size: 22rpx; color: #667eea; }
.btn-submit {
  width: 100%; height: 96rpx; line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff; border-radius: 48rpx; font-size: 32rpx; font-weight: 600;
  border: none; box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.4);
}
.btn-submit::after { border: none; }

/* 成功页 */
.success-page { }
.success-hero  { text-align: center; padding: 60rpx 40rpx 40rpx; }
.success-icon  { font-size: 100rpx; margin-bottom: 20rpx; }
.success-title { font-size: 44rpx; font-weight: 700; color: #fff; margin-bottom: 16rpx; }
.success-desc  { font-size: 26rpx; color: rgba(255,255,255,0.65); }

/* 二维码卡片 */
.qr-card {
  background: #fff; border-radius: 24rpx;
  margin: 0 30rpx 24rpx; padding: 40rpx;
  text-align: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.qr-title   { font-size: 30rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 28rpx; }
.qr-image   { width: 300rpx; height: 300rpx; margin-bottom: 24rpx; }
.qr-placeholder {
  width: 300rpx; height: 300rpx; background: #f5f7fa; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx;
}
.qr-placeholder-text { font-size: 24rpx; color: #bbb; }
.wechat-row  { display: flex; justify-content: center; align-items: center; margin-bottom: 28rpx; }
.wechat-label { font-size: 26rpx; color: #666; }
.wechat-val   { font-size: 28rpx; color: #1a1a2e; font-weight: 600; }
.qr-btns { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.btn-copy-wechat {
  flex: 1; height: 72rpx; line-height: 72rpx; border-radius: 36rpx;
  background: #f0f4ff; color: #667eea; font-size: 26rpx; border: none;
}
.btn-save-qr {
  flex: 1; height: 72rpx; line-height: 72rpx; border-radius: 36rpx;
  background: linear-gradient(135deg, #667eea, #764ba2); color: #fff;
  font-size: 26rpx; border: none;
}
.btn-copy-wechat::after, .btn-save-qr::after { border: none; }
.qr-tip { font-size: 22rpx; color: #999; }

/* 返回按钮 */
.back-wrap { padding: 20rpx 30rpx; text-align: center; }
.btn-back  {
  background: transparent; color: #999; font-size: 26rpx; border: none;
}
.btn-back::after { border: none; }
