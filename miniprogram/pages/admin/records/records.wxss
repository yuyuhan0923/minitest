.container {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.total-count {
  font-size: 26rpx;
  color: #999;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.filter-label {
  font-size: 24rpx;
  color: #999;
}
.filter-chip {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}
.filter-chip.active {
  background: #2f54eb;
  color: #fff;
}

/* 状态提示 */
.state-box {
  text-align: center;
  padding: 80rpx 0;
}
.state-text {
  font-size: 28rpx;
  color: #999;
}
.error-text {
  font-size: 28rpx;
  color: #cf1322;
  display: block;
  margin-bottom: 20rpx;
}
.retry-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 10rpx 32rpx;
  border-radius: 10rpx;
  background: #e8f3ff;
}

/* 记录卡片 */
.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.item:active {
  background: #f0f4ff;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.level-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #e8f3ff;
  color: #2f54eb;
  font-weight: 500;
}

.phone-row {
  margin-bottom: 10rpx;
}
.phone-text {
  font-size: 26rpx;
  color: #666;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.score-main {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.score-pct {
  font-size: 24rpx;
  color: #999;
}

.cat-box {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.cat-chip {
  font-size: 22rpx;
  color: #888;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.meta-time {
  font-size: 22rpx;
  color: #bbb;
}
.meta-openid {
  font-size: 18rpx;
  color: #ddd;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0 48rpx;
  gap: 32rpx;
}
.page-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  background: #e8f3ff;
}
.page-btn.disabled {
  color: #bbb;
  background: #f5f5f5;
}
.page-info {
  font-size: 26rpx;
  color: #666;
}

/* 详情弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.detail-panel {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
}
.detail-body {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 32rpx 40rpx;
}

.d-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.d-row:last-child { border-bottom: none; }
.d-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}
.d-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}
.d-openid {
  font-size: 22rpx;
  color: #bbb;
}

.d-section {
  margin-top: 24rpx;
}
.d-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}
.d-cat-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.d-cat-name {
  font-size: 26rpx;
  color: #555;
}
.d-cat-score {
  font-size: 26rpx;
  color: #2f54eb;
  font-weight: 500;
}

.d-suggest {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.d-suggest-dot {
  font-size: 28rpx;
  color: #2f54eb;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.d-suggest-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}
