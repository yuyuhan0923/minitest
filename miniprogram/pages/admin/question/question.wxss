.container {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.total-count {
  font-size: 26rpx;
  color: #999;
}

/* 搜索框 */
.search-bar {
  margin-bottom: 16rpx;
}
.search-input {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 维度筛选 */
.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.filter-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
.filter-scroll {
  flex: 1;
  white-space: nowrap;
}
.filter-chip {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
  margin-right: 10rpx;
}
.filter-chip.active {
  background: #2f54eb;
  color: #fff;
}

/* 状态提示 */
.state-box {
  text-align: center;
  padding: 80rpx 0;
}
.state-text {
  font-size: 28rpx;
  color: #999;
}
.error-text {
  font-size: 28rpx;
  color: #cf1322;
  display: block;
  margin-bottom: 20rpx;
}
.retry-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 10rpx 32rpx;
  border-radius: 10rpx;
  background: #e8f3ff;
}

/* 题目卡片 */
.q-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.q-card:active {
  background: #f5f8ff;
}

.q-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}
.q-head-left {
  flex: 1;
  display: flex;
  align-items: flex-start;
  margin-right: 16rpx;
}
.q-order {
  font-size: 24rpx;
  color: #2f54eb;
  font-weight: 600;
  min-width: 48rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.q-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.5;
}

/* 启用/禁用按钮 */
.status-btn {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.status-btn.enabled {
  background: #e6ffed;
  color: #389e0d;
}
.status-btn.disabled {
  background: #fff2e6;
  color: #d46b08;
}
.status-btn.toggling {
  background: #f0f0f0;
  color: #999;
}

/* 元信息标签 */
.q-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.meta-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.cat-tag {
  background: #e8f3ff;
  color: #2f54eb;
}
.score-tag {
  background: #f5f5f5;
  color: #666;
}
.answer-tag {
  background: #e6ffed;
  color: #389e0d;
}

/* 选项预览 */
.q-options-preview {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.opt-preview {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0 48rpx;
  gap: 32rpx;
}
.page-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  background: #e8f3ff;
}
.page-btn.disabled {
  color: #bbb;
  background: #f5f5f5;
}
.page-info {
  font-size: 26rpx;
  color: #666;
}

/* 详情弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.detail-panel {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
}
.detail-body {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 32rpx 40rpx;
}

.d-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.d-row:last-child { border-bottom: none; }
.d-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  padding-top: 2rpx;
}
.d-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}
.d-title {
  font-weight: 500;
  line-height: 1.6;
}
.answer-highlight {
  color: #389e0d;
  font-weight: 600;
  font-size: 32rpx;
}
.text-green { color: #389e0d; }
.text-orange { color: #d46b08; }

.d-section {
  margin-top: 24rpx;
}
.d-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}
.d-opt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  background: #f9fafb;
}
.d-opt-row.correct-opt {
  background: #e6ffed;
}
.d-opt-label {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}
.correct-mark {
  font-size: 28rpx;
  color: #389e0d;
  font-weight: 700;
  margin-left: 12rpx;
}
