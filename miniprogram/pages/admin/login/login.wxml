<view class="login-page">
  <view class="login-card">
    <view class="login-icon">🛡️</view>
    <text class="login-title">管理员登录</text>
    
    <view class="input-group">
      <input class="input-item" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="input-group">
      <input class="input-item" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput" />
    </view>
    
    <button class="login-btn" bindtap="onLogin">登录</button>
  </view>
</view>