.container {
  padding: 24rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.logout-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(47, 84, 235, 0.1);
}

.login-time-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-left: 8rpx solid #2f54eb;
}

.login-time-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.login-time-value {
  font-size: 26rpx;
  color: #2f54eb;
  font-weight: 600;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-card.blue  { background: #e8f3ff; }
.stat-card.green { background: #e6ffed; }
.stat-card.orange{ background: #fff7e6; }

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.stat-loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.entry-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
}

.entry-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.entry-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  height: 82vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.detail-panel {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow-y: auto;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.panel-search {
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.search-input {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.filter-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 14rpx 32rpx;
  gap: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.filter-label {
  font-size: 24rpx;
  color: #999;
}

.filter-chip {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #f5f7fa;
  color: #666;
}

.filter-chip.active {
  background: #2f54eb;
  color: #fff;
}

.panel-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 32rpx 0;
}

.user-loading, .user-empty, .user-error {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.user-error { color: #cf1322; }

.retry-btn {
  color: #2f54eb;
  margin-left: 8rpx;
}

.user-item {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.user-item:active { background: #eef2ff; }

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.user-phone {
  font-size: 26rpx;
  color: #666;
}

.user-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.meta-dot { margin: 0 10rpx; }

.user-level {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.level-gao   { background: #fff1f0; color: #cf1322; }
.level-zhong { background: #fff7e6; color: #d46b08; }
.level-chu   { background: #e8f3ff; color: #2f54eb; }

.user-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.tag-huoyue    { background: #e6ffed; color: #389e0d; }
.tag-xinyonghu { background: #fff7e6; color: #d46b08; }
.tag-chenmo    { background: #f5f5f5; color: #999; }

.lead-yes { color: #389e0d; }
.lead-no  { color: #bbb; }

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0 32rpx;
  gap: 32rpx;
}

.page-btn {
  font-size: 28rpx;
  color: #2f54eb;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  background: #e8f3ff;
}

.page-btn.disabled {
  color: #bbb;
  background: #f5f5f5;
}

.page-info {
  font-size: 26rpx;
  color: #666;
}

.detail-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.detail-body { padding: 8rpx 32rpx 32rpx; }

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child { border-bottom: none; }

.detail-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.detail-openid {
  font-size: 22rpx;
  color: #999;
}
