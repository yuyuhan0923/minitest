.container{padding:30rpx;background:#f5f7fa;min-height:100vh;}
.page-title{font-size:38rpx;font-weight:600;margin-bottom:12rpx;color:#333;}
.desc{font-size:26rpx;color:#666;margin-bottom:30rpx;}

.card{background:#fff;border-radius:20rpx;padding:30rpx;margin-bottom:30rpx;}
.row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;}
.row:last-child{border-bottom:none;}
.label{color:#666;font-weight:500;}
.value{color:#1677ff;font-weight:400;max-width:500rpx;text-align:right;word-break:break-all;}

.qrcode-item{padding:20rpx 0;border-bottom:1rpx solid #f0f0f0;}
.qrcode-item:last-child{border-bottom:none;}
.qrcode-wrap{display:flex;flex-direction:column;align-items:center;margin-top:15rpx;}
.qrcode{width:200rpx;height:200rpx;border-radius:8rpx;margin-bottom:8rpx;}
.tip{font-size:24rpx;color:#999;}
.empty{font-size:26rpx;color:#999;margin-top:15rpx;display:block;}

.tip{font-size:24rpx;color:#999;text-align:center;}