.container{padding:30rpx;background:#f5f7fa;min-height:100vh;}
.page-title{font-size:38rpx;font-weight:600;margin-bottom:12rpx;color:#333;}
.desc{font-size:26rpx;color:#666;margin-bottom:30rpx;}

.card{background:#fff;border-radius:20rpx;padding:40rpx 30rpx;margin-bottom:30rpx;}
.row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;}
.row:last-child{border-bottom:none;}
.label{color:#666;font-weight:500;}
.value{color:#333;font-weight:400;max-width:500rpx;text-align:right;word-break:break-all;}
.value.link{color:#1677ff;}

.tip{font-size:24rpx;color:#999;text-align:center;}